{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/usecommon/dadl/schema/calibration-1.schema.json",
  "title": "DADL calibration artifact manifest, version 1",
  "description": "Manifest of an immutable, content-addressed calibration artifact. The artifact ID is the SHA-256 of this manifest canonicalized with RFC 8785 (JCS), excluding the signature field. See docs/design.md, 'Calibration artifact format'.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "kind", "channels", "method", "created", "backend", "inputs", "posterior", "checks", "software"],
  "properties": {
    "schema": { "const": "calibration/1" },
    "kind": {
      "description": "What was calibrated. Parameters fitted from the same data share one artifact (one joint posterior).",
      "enum": ["dark-afterpulse-deadtime", "heralding-efficiency", "delay-jitter", "crosstalk", "klyshko", "drift-filter-state"]
    },
    "channels": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["device", "input"],
        "properties": {
          "device": { "type": "string", "description": "Device serial or simulator ID" },
          "input": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "method": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "type": "string" },
        "version": { "type": "string" }
      }
    },
    "created": { "type": "string", "format": "date-time" },
    "valid_for": {
      "description": "Time range and conditions the artifact may be applied to. Datasets outside it are refused unless overridden.",
      "type": "object",
      "properties": {
        "from": { "type": "string", "format": "date-time" },
        "to": { "type": "string", "format": "date-time" },
        "conditions": { "type": "object" }
      }
    },
    "backend": { "enum": ["sim", "hardware"] },
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sha256", "role"],
        "properties": {
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "role": { "enum": ["raw-tags", "histogram", "telemetry", "config", "previous-artifact"] }
        }
      }
    },
    "conditions": {
      "description": "Measured conditions during calibration, e.g. temperature_K, bias_V.",
      "type": "object",
      "additionalProperties": { "type": "number" }
    },
    "posterior": {
      "type": "object",
      "additionalProperties": false,
      "required": ["format", "sha256", "n_samples", "params"],
      "properties": {
        "format": { "const": "arrow" },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "n_samples": { "type": "integer", "minimum": 1 },
        "params": { "type": "array", "items": { "type": "string" }, "minItems": 1 }
      }
    },
    "checks": {
      "type": "object",
      "required": ["converged", "ppc_pvalue"],
      "properties": {
        "converged": { "type": "boolean" },
        "ppc_pvalue": { "type": "number", "minimum": 0, "maximum": 1 },
        "prior_dominated_params": { "type": "array", "items": { "type": "string" } }
      }
    },
    "supersedes": {
      "description": "ID of the artifact this one replaces for the same channels and kind.",
      "type": ["string", "null"],
      "pattern": "^[0-9a-f]{64}$"
    },
    "software": {
      "type": "object",
      "required": ["dadl"],
      "properties": {
        "dadl": { "type": "string" },
        "plugins": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "version", "sha256"],
            "properties": {
              "name": { "type": "string" },
              "version": { "type": "string" },
              "sha256": { "type": "string" }
            }
          }
        }
      }
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["alg", "key_id", "sig"],
      "properties": {
        "alg": { "const": "ed25519" },
        "key_id": { "type": "string" },
        "sig": { "type": "string" }
      }
    }
  }
}
